VERSION = "0.3.0"
HOME = os.path.expanduser("~")
BIN = os.path.join(HOME, ".local/bin")
OPT = os.path.join(HOME, ".local/opt")
UNIT_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "systemd/user")
VRCMD_DIR = "/opt/steamvr/bin/linuxarm64"
RECENT_SECONDS = 120        # 「今も出ている」とみなすログの範囲
STARTUP_GRACE_SECONDS = 60  # 起動直後のこの秒数のログは、起動時のよくある一時的なものとして数えない
EYE_MMAP = "/dev/shm/eye-server.mmap"
ROOM_VIEW_STYLES = {0: "既定", 1: "輪郭 A", 2: "輪郭 B", 3: "半透明の映像", 4: "不透明な映像"}

# (表示名, unit, バージョンの取り方, プロセス名, パネルの「閉じる」で終われるもの)
TOOLS = [
    ("frameeyeosc", "frameeyeosc", ("bin", "frameeyeosc-panel"), "frameeyeosc", False),
    ("frameeyeosc パネル", "frameeyeosc-panel", ("bin", "frameeyeosc-panel"), "frameeyeosc-pan", True),
    ("frame-aux-shortcuts", "frame-aux-shortcuts", ("bin", "frame-aux-shortcuts"), "frame-aux-short", False),
    ("frame-mic-tuner", "frame-mic-tuner", ("bin", "frame-mic-tuner"), "frame-mic-tuner", True),
    ("frame-perf-overlay", "frame-perf-overlay", ("bin", "frame-perf-overlay"), "frame-perf-over", True),
    ("frame-vitals-osc", "frame-vitals-osc", ("py", "frame-vitals-osc/frame-vitals-osc.py"), None, False),
    ("frame-gaze-gestures", "frame-gaze-gestures", ("py", "frame-gaze-gestures/frame-gaze-gestures.py"), None, False),
    ("vrc-wrist-notifier", "vrc-wrist-notifier", ("opt", "vrc-wrist-notifier/wrist-toast"), "wrist-toast", False),
]

OK, INFO, WARN, ERROR = "OK", "INFO", "WARN", "ERROR"
RANK = {OK: 0, INFO: 0, WARN: 1, ERROR: 2}


def use_real_user_session():
    """デスクトップモードや SSH でも systemctl --user / journalctl --user が本来のセッションに届くようにする。"""
    real = f"/run/user/{os.getuid()}"
    cur = os.environ.get("XDG_RUNTIME_DIR", "")
    if not os.path.exists(os.path.join(cur, "systemd/private")) and os.path.exists(os.path.join(real, "systemd/private")):
        os.environ["XDG_RUNTIME_DIR"] = real
        if os.path.exists(os.path.join(real, "bus")):
            os.environ["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={real}/bus"


def run(cmd, timeout=10, cwd=None, env=None):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, cwd=cwd,
                           env=dict(os.environ, **(env or {})))
        return p.returncode, (p.stdout + p.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return -1, str(e)


def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


class Report:
    def __init__(self):
        self.items = []

    def add(self, section, level, title, message, brief=None, reason=None, **data):
        """brief: ふだんの表示（1 行ずつ）に出すときの名前。None ならくわしい表示（--verbose）だけ。
        reason: 警告・エラーのときにかっこ内に書く短い説明（無ければ message）。"""
        self.items.append({"section": section, "level": level, "title": title, "message": message,
                           "brief": brief, "reason": reason, "data": data})


# ---------------------------------------------------------------- 本体のようす
def check_temps(r, warn_c, error_c):
    zones = []
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        t, v = read(z + "/type") or "", read(z + "/temp")
        if v and v.lstrip("-").isdigit():
            zones.append((t, int(v) / 1000.0))
    soc = [(t, v) for t, v in zones if re.match(r"^(cpu|cpuss|gpuss)", t)]
    if not soc:
        r.add("本体", INFO, "温度", "温度センサーが見つかりません")
        return
    name, hot = max(soc, key=lambda x: x[1])
    gpu = max((v for t, v in soc if t.startswith("gpuss")), default=None)
    level = ERROR if hot >= error_c else WARN if hot >= warn_c else OK
    msg = f"SoC 最高 {hot:.1f} °C（{name}）"
    if gpu is not None:
        msg += f"、GPU {gpu:.1f} °C"
    reason = f"{hot:.0f} °C。少し外して冷ましてください" if level != OK else None
    r.add("本体", level, "温度", msg, brief="温度", reason=reason, hottest_c=hot, hottest_zone=name, gpu_c=gpu)


def check_throttling(r):
    limited = []
    for c in glob.glob("/sys/class/thermal/cooling_device*"):
        t, cur = read(c + "/type") or "", read(c + "/cur_state")
        if (t.startswith("cpufreq") or "gpu" in t) and cur and cur.isdigit() and int(cur) > 0:
            limited.append(f"{t} {cur}/{read(c + '/max_state')}")
    capped = []
    for p in sorted(glob.glob("/sys/devices/system/cpu/cpufreq/policy*")):
        mx, hw = read(p + "/scaling_max_freq"), read(p + "/cpuinfo_max_freq")
        if mx and hw and mx.isdigit() and hw.isdigit() and int(mx) < int(hw):
            capped.append(f"{os.path.basename(p)} {int(mx) // 1000}/{int(hw) // 1000} MHz")
    if limited or capped:
        r.add("本体", WARN, "熱による制限", "クロックが下げられています: " + "、".join(limited + capped),
              brief="熱による制限", reason="熱で動作が遅くされています", cooling=limited, capped=capped)
    else:
        r.add("本体", OK, "熱による制限", "制限なし（CPU・GPU とも最大クロックまで使えます）", brief="熱による制限",
              cooling=[], capped=[])


def check_battery(r):
    bats = [b for b in glob.glob("/sys/class/power_supply/*") if read(b + "/type") == "Battery"]
    if not bats:
        r.add("本体", INFO, "バッテリー", "バッテリーが見つかりません")
        return
    b = bats[0]
    cap, status, temp = read(b + "/capacity"), read(b + "/status"), read(b + "/temp")
    capn = int(cap) if cap and cap.isdigit() else None
    charging = status in ("Charging", "Full")
    ja = {"Charging": "充電中", "Discharging": "放電中", "Full": "満充電", "Not charging": "充電していない"}.get(status, status)
    level = OK
    if capn is not None and not charging:
        level = ERROR if capn < 10 else WARN if capn < 20 else OK
    msg = f"{cap}%（{ja}）"
    if temp and temp.lstrip("-").isdigit():
        msg += f"、{int(temp) / 10:.1f} °C"
    reason = f"残り {capn}%。充電してください" if level != OK else None
    r.add("本体", level, "バッテリー", msg, brief="バッテリー", reason=reason, percent=capn, status=status)


def size(n):
    for unit, k in (("TB", 1e12), ("GB", 1e9), ("MB", 1e6)):
        if n >= k:
            return f"{n / k:.1f} {unit}" if n < 10 * k else f"{n / k:.0f} {unit}"
    return f"{n} B"


def check_disks(r):
    seen = set()
    worst = None
    for mnt, label in (("/", "システム"), ("/home", "ホーム"), ("/var", "/var")):
        try:
            st = os.statvfs(mnt)
        except OSError:
            continue
        if st.f_fsid in seen:
            continue
        seen.add(st.f_fsid)
        total, free = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
        pct = 100.0 * free / total if total else 0
        level = ERROR if pct < 5 else WARN if pct < 10 else OK
        r.add("本体", level, f"空き容量（{label}）", f"{size(free)} 空き / {size(total)}（{pct:.0f}%）",
              mount=mnt, free_bytes=free, total_bytes=total)
        if worst is None or RANK[level] > RANK[worst[0]]:
            worst = (level, f"{label}の残りが {size(free)}")
    if worst:   # ふだんの表示は 1 行にまとめる
        r.add("本体", worst[0], "空き容量", "（上の各項目のまとめ）", brief="空き容量",
              reason=worst[1] if worst[0] != OK else None)


def check_uptime(r):
    up = read("/proc/uptime")
    if not up:
        return
    secs = float(up.split()[0])
    boot = datetime.datetime.fromtimestamp(time.time() - secs)
    d, rem = divmod(int(secs), 86400)
    h, m = rem // 3600, rem % 3600 // 60
    r.add("本体", INFO, "起動してから", f"{d} 日 {h} 時間 {m} 分（最後の起動 {boot:%m/%d %H:%M}）",
          uptime_s=secs, boot=boot.isoformat(timespec="seconds"))


# ---------------------------------------------------------------- SteamVR とツール
def unit_state(unit):
    _, active = run(["systemctl", "--user", "is-active", unit + ".service"], timeout=5)
    _, enabled = run(["systemctl", "--user", "is-enabled", unit + ".service"], timeout=5)
    return active.splitlines()[-1] if active else "unknown", enabled.splitlines()[-1] if enabled else "unknown"


def steamvr_running():
    active, _ = unit_state("steamvr")
    rc, _ = run(["pgrep", "-x", "vrserver"], timeout=5)
    return active == "active" or rc == 0


def check_steamvr(r):
    active, _ = unit_state("steamvr")
    rc, _ = run(["pgrep", "-x", "vrserver"], timeout=5)
    if active == "active" or rc == 0:
        r.add("SteamVR", OK, "SteamVR", "動いています", brief="SteamVR", service=active, vrserver=rc == 0)
    else:
        # デスクトップモードでは止まっているのが普通なので、警告にはしない
        r.add("SteamVR", INFO, "SteamVR", "動いていません（デスクトップモードなら正常）", brief="SteamVR", reason="停止中",
              service=active, vrserver=False)


def tool_version(how):
    kind, rel = how
    if kind in ("bin", "opt"):   # bin: ~/.local/bin の実行ファイル、opt: ~/.local/opt の中の実行ファイル
        path = os.path.join(BIN if kind == "bin" else OPT, rel)
        if not os.access(path, os.X_OK):
            return None, False
        rc, out = run([path, "--version"], timeout=5)
    else:
        path = os.path.join(OPT, rel)
        if not os.path.exists(path):
            return None, False
        rc, out = run([sys.executable, path, "--version"], timeout=5)
    line = out.splitlines()[0] if out else ""
    m = re.search(r"(\d+\.\d+\.\d+\S*)", line)
    return (m.group(1) if m else None), True


def stale_processes(proc):
    """古い版のまま動いているプロセス（更新でファイルが置き換わった）の PID。"""
    if not proc:
        return []
    rc, out = run(["pgrep", "-x", proc], timeout=5)
    stale = []
    for pid in out.split() if rc == 0 else []:
        try:
            if os.readlink(f"/proc/{pid}/exe").endswith(" (deleted)"):
                stale.append(int(pid))
        except OSError:
            pass
    return stale


def check_tools(r, vr_running):
    for label, unit, how, proc, closable in TOOLS:
        ver, installed = tool_version(how)
        unit_file = os.path.exists(os.path.join(UNIT_DIR, unit + ".service"))
        if not installed and not unit_file:
            r.add("ツール", INFO, label, "入っていません", installed=False)
            continue
        active, enabled = unit_state(unit)
        auto = {"enabled": "自動起動オン", "disabled": "自動起動オフ"}.get(enabled, f"自動起動 {enabled}")
        running = active == "active"
        if not running and proc:
            running = run(["pgrep", "-x", proc], timeout=5)[0] == 0   # ダッシュボードの＋から起動したもの
        stale = stale_processes(proc)
        msg = f"{ver or '?'}、{'動作中' if running else '停止中'}、{auto}"
        level, brief, reason = OK, (label if running else None), None
        if stale:
            # 動いてはいるので異常ではない（更新のあと、次に起動したときに新しい版になる）
            msg += "。更新前の版のまま動いています（終了するか SteamVR を再起動すると新しい版になります）"
        if enabled == "enabled" and vr_running and not running:
            if closable:
                level = INFO
                msg += "。閉じられています（ダッシュボードの＋から開けます。次の SteamVR 起動で自動で開きます）"
            else:
                level, brief, reason = WARN, label, "SteamVR が動いているのに止まっています"
                msg += "。" + reason
        elif not running:
            level = INFO   # 自動起動オフで止まっている・SteamVR が止まっている: ふつうの状態なので、ふだんは出さない
        r.add("ツール", level, label, msg, brief=brief, reason=reason, version=ver, active=active, enabled=enabled,
              running=running, stale_pids=stale)


def check_audio(r):
    """既定のマイクとスピーカーが今あるか（wpctl で読むだけ）。"""
    if not shutil.which("wpctl"):
        r.add("音", INFO, "音", "wpctl がありません")
        return
    for target, name in (("@DEFAULT_AUDIO_SOURCE@", "マイク"), ("@DEFAULT_AUDIO_SINK@", "スピーカー")):
        rc, out = run(["wpctl", "get-volume", target], timeout=5)
        m = re.search(r"Volume:\s*([\d.]+)(.*)", out)
        if rc == 0 and m:
            muted = "MUTED" in m.group(2)
            r.add("音", OK, name, f"音量 {float(m.group(1)) * 100:.0f}%{'（ミュート中）' if muted else ''}", brief=name,
                  volume=float(m.group(1)), muted=muted)
        else:
            r.add("音", WARN, name, f"既定の{name}が見つかりません（{out[:100]}）", brief=name,
                  reason=f"既定の{name}が見つかりません")


def check_eye(r, vr_running):
    """frameeyeosc が今、目のデータを読めているか（status.json と eye-server.mmap を見るだけ）。"""
    if not os.path.exists(os.path.join(UNIT_DIR, "frameeyeosc.service")):
        return
    active, _ = unit_state("frameeyeosc")
    if active != "active":
        return   # 動いているかどうかはツールの項目で見る
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "frameeyeosc/status.json")
    try:
        with open(path) as f:
            st = json.load(f)
    except (OSError, ValueError):
        st = None
    now = time.time()
    age = now - st.get("time", 0) if st else None
    problem = None
    if st is None or age > 10:
        problem = "frameeyeosc の状態が更新されていません"
    elif st.get("source_error"):
        problem = f"目のデータが読めません（{str(st['source_error'])[:80]}）"
    elif st.get("config_error"):
        problem = f"設定ファイルに問題があります（{str(st['config_error'])[:80]}）"
    elif vr_running and not os.path.exists(EYE_MMAP):
        problem = "目のデータが読めません（目のデータのファイルがありません）"
    else:
        le = st.get("last_error") or {}
        t, started = le.get("time") or 0, st.get("started") or 0
        if now - t < RECENT_SECONDS and t - started > STARTUP_GRACE_SECONDS:
            problem = f"いまエラーが出ています（{str(le.get('text'))[:80]}）"
    if problem:
        r.add("ツール", WARN, "視線データ", problem, brief="視線データ", reason=problem)
    else:
        r.add("ツール", OK, "視線データ",
              f"読めています（{age:.1f} 秒前に更新、{'目を追えています' if st.get('tracking') else 'かぶっていないか、目を追えていません'}）",
              brief="視線データ", tracking=st.get("tracking"))


def check_network(r, host="github.com", port=443, timeout=4.0):
    """インターネットにつながるか（名前解決と、つなげるかだけ。何も送らない）。"""
    result = {}

    def resolve():
        try:
            result["addr"] = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
        except OSError as e:
            result["err"] = e
    th = threading.Thread(target=resolve, daemon=True)
    th.start()
    th.join(timeout)
    if "addr" not in result:
        r.add("ネット", WARN, "ネット", f"{host} の名前解決ができません", brief="ネット",
              reason="インターネットにつながりません（名前解決ができません）")
        return
    family, stype, proto, _, sa = result["addr"][0]
    try:
        with socket.socket(family, stype, proto) as sk:
            sk.settimeout(timeout)
            sk.connect(sa)
    except OSError:
        r.add("ネット", WARN, "ネット", f"{host}:{port} につながりません", brief="ネット",
              reason="インターネットにつながりません")
        return
    r.add("ネット", OK, "ネット", f"{host} につながります", brief="ネット")


def check_mic(r):
    if not shutil.which("wpctl"):
        r.add("マイク", INFO, "マイクのフィルター", "wpctl がありません")
        return
    vals = {}
    for key, ja in (("frame-mic.echo-cancel", "エコー除去"), ("frame-mic.noise-suppression", "ノイズ除去")):
        rc, out = run(["wpctl", "settings", key], timeout=5)
        m = re.search(r"Value:\s*(\S+)", out)
        vals[key] = m.group(1) if (rc == 0 and m) else None
        if vals[key] is None:
            r.add("マイク", INFO, ja, "設定がありません（frame-mic-tuner が入っていない？）", key=key, value=None)
        else:
            r.add("マイク", INFO, ja, {"true": "オン", "false": "オフ"}.get(vals[key], vals[key]), key=key, value=vals[key])


def check_passthrough(r, vr_running):
    vrcmd = os.path.join(VRCMD_DIR, "vrcmd")
    if not os.path.exists(vrcmd):
        r.add("SteamVR", INFO, "パススルーの表示", "vrcmd が見つかりません")
        return
    if not vr_running:
        r.add("SteamVR", INFO, "パススルーの表示", "SteamVR が止まっているので読めません")
        return
    rc, out = run(["./vrcmd", "--settings-int", "camera.roomViewStyle"], timeout=10, cwd=VRCMD_DIR,
                  env={"LD_LIBRARY_PATH": "."})
    m = re.search(r"camera\.roomViewStyle\s*=\s*(-?\d+)", out)
    if not m:
        r.add("SteamVR", INFO, "パススルーの表示", "読めませんでした", output=out[-200:])
        return
    v = int(m.group(1))
    r.add("SteamVR", INFO, "パススルーの表示", f"roomViewStyle = {v}（{ROOM_VIEW_STYLES.get(v, '不明')}）", value=v)


ERROR_PATTERN = re.compile(r"error|failed|panic|fatal|エラー|失敗", re.I)
# 「エラーなし」を表す言い方（VROverlayError_None、errors=0 など）は数えない
NOT_ERROR = re.compile(r"\w*Error_None\b|\bno errors?\b|\berrors?[=: ]+0\b|error[=: ]+(none|null)\b", re.I)


def looks_like_error(line):
    return bool(ERROR_PATTERN.search(NOT_ERROR.sub("", line)))


def log_units():
    return ["steamvr"] + [t[1] for t in TOOLS if os.path.exists(os.path.join(UNIT_DIR, t[1] + ".service"))]


def unit_started(unit):
    """サービスが今の状態になった時刻（UNIX 秒）。分からなければ None。"""
    _, out = run(["systemctl", "--user", "show", "-p", "ActiveEnterTimestamp", "--timestamp=unix", "--value",
                  unit + ".service"], timeout=5)
    m = re.search(r"@(\d+)", out)
    return int(m.group(1)) if m else None


ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")   # ログに入っている色の指定


def error_lines(unit, since):
    rc, out = run(["journalctl", "--user", "-u", unit + ".service", "--since", since, "--no-pager", "-o", "cat"],
                  timeout=20)
    out = ANSI.sub("", out)
    lines = [l for l in out.splitlines() if l and not l.startswith("-- ")]
    errs = [l for l in lines if looks_like_error(l)]
    _, prio = run(["journalctl", "--user", "-u", unit + ".service", "--since", since, "-p", "err",
                   "--no-pager", "-o", "cat"], timeout=20)
    prio_lines = [l for l in ANSI.sub("", prio).splitlines() if l and not l.startswith("-- ")]
    return errs + [l for l in prio_lines if l not in errs]


def check_logs(r, now=None):
    """今もエラーが出ているか: 直近 2 分のログだけを見る。起動して 1 分以内のログ（起動時の一時的なもの）は数えない。"""
    if not shutil.which("journalctl"):
        return
    now = now or time.time()
    for unit in log_units():
        since = now - RECENT_SECONDS
        started = unit_started(unit)
        if started:
            since = max(since, started + STARTUP_GRACE_SECONDS)
        if since >= now:
            r.add("ログ", OK, unit, "起動したばかりなので、まだ見ていません", count=0)
            continue
        errs = error_lines(unit, f"@{int(since)}")
        if errs:
            reason = f"今もエラーが出ています: {errs[-1][:80]}"
            r.add("ログ", WARN, unit, f"直近 {RECENT_SECONDS // 60} 分にエラーらしい行が {len(errs)} 行（最後: {errs[-1][:120]}）",
                  brief=f"{unit} のログ", reason=reason, count=len(errs), last=errs[-1])
        else:
            r.add("ログ", OK, unit, f"直近 {RECENT_SECONDS // 60} 分はエラーなし", count=0)


def check_history(r, since):
    """--history: 過去のログのエラーを参考として出す（判定には使わない）。"""
    if not shutil.which("journalctl"):
        return
    for unit in log_units():
        errs = error_lines(unit, since)
        if errs:
            r.add("過去のログ", INFO, unit, f"{len(errs)} 行（最後: {errs[-1][:120]}）", count=len(errs), last=errs[-1], past=True)
        else:
            r.add("過去のログ", INFO, unit, "なし", count=0, past=True)


# ---------------------------------------------------------------- 表示
WORD = {OK: "正常", WARN: "警告", ERROR: "エラー"}


def brief_line(it):
    lv = it["level"]
    if lv == INFO:
        return f"{it['brief']}：{it['reason'] or it['message']}"
    if lv == OK:
        return f"{it['brief']}：正常"
    return f"{it['brief']}：{WORD[lv]}（{it['reason'] or it['message']}）"


def render_brief(report, color, history_since):
    c = {OK: "\033[32m", INFO: "\033[36m", WARN: "\033[33m", ERROR: "\033[31m", "0": "\033[0m"}
    if not color:
        c = {k: "" for k in c}
    now_items = [i for i in report.items if not i["data"].get("past")]
    for it in now_items:
        if it["brief"]:
            print(f"{c[it['level']]}{brief_line(it)}{c['0']}")
    if any(i["level"] in (WARN, ERROR) for i in now_items):
        print("（くわしくは frame-doctor --verbose）")
    render_history(report, history_since)


def render_history(report, since):
    past = [i for i in report.items if i["data"].get("past")]
    if not past:
        return
    print(f"\n■ 過去のログ（直近 {since}。参考です。今の状態とは関係ありません）")
    for it in past:
        print(f"  {it['title']}: {it['message']}")


def render(report, color, history_since=None):
    c = {"OK": "\033[32m", "INFO": "\033[36m", "WARN": "\033[33m", "ERROR": "\033[31m", "b": "\033[1m", "d": "\033[2m", "0": "\033[0m"}
    if not color:
        c = {k: "" for k in c}
    now = datetime.datetime.now().astimezone()
    print(f"{c['b']}frame-doctor {VERSION} — Steam Frame の健康チェック（{now:%Y-%m-%d %H:%M} {now.tzname()}）{c['0']}")
    section = None
    items = [i for i in report.items if not i["data"].get("past")]
    for it in items:
        if it["section"] != section:
            section = it["section"]
            extra = f"（直近 {RECENT_SECONDS // 60} 分。起動直後の 1 分は数えません）" if section == "ログ" else ""
            print(f"\n{c['b']}■ {section}{extra}{c['0']}")
        lv = it["level"]
        print(f"  {c[lv]}[{lv:^5}]{c['0']} {it['title']}: {it['message']}")
    counts = {k: sum(1 for i in items if i["level"] == k) for k in (OK, INFO, WARN, ERROR)}
    print(f"\n{c['b']}まとめ:{c['0']} {c['OK']}OK {counts[OK]}{c['0']} / {c['INFO']}INFO {counts[INFO]}{c['0']} / "
          f"{c['WARN']}WARN {counts[WARN]}{c['0']} / {c['ERROR']}ERROR {counts[ERROR]}{c['0']}")
    render_history(report, history_since)


def main(argv=None):
    ap = argparse.ArgumentParser(description="Steam Frame の健康チェック（読むだけ）。いまの状態だけで判定します")
    ap.add_argument("-v", "--verbose", action="store_true", help="くわしく（各項目の値も出す）")
    ap.add_argument("--json", action="store_true", help="JSON で出す")
    ap.add_argument("--history", nargs="?", const="24h", metavar="範囲",
                    help="過去のログのエラーも参考として出す（既定 24h。判定には使わない）")
    ap.add_argument("--no-color", action="store_true", help="色を付けない")
    ap.add_argument("--since", help=argparse.SUPPRESS)   # 0.2 までの互換: --history と同じ
    ap.add_argument("--no-network", action="store_true", help="ネットの確認をしない")
    ap.add_argument("--warn-temp", type=float, default=80.0, help="温度の注意ライン（°C）")
    ap.add_argument("--error-temp", type=float, default=90.0, help="温度のエラーライン（°C）")
    ap.add_argument("--version", action="version", version=f"frame-doctor {VERSION}")
    a = ap.parse_args(argv)
    hist = a.history or a.since
    hist_since = None
    if hist:
        hist_since = f"-{hist}" if re.fullmatch(r"\d+[smhd]", hist) else hist

    use_real_user_session()
    r = Report()
    check_temps(r, a.warn_temp, a.error_temp)
    check_throttling(r)
    check_battery(r)
    check_disks(r)
    check_uptime(r)
    vr = steamvr_running()
    check_steamvr(r)
    check_passthrough(r, vr)
    check_tools(r, vr)
    check_eye(r, vr)
    check_audio(r)
    check_mic(r)
    if not a.no_network:
        check_network(r)
    check_logs(r)
    if hist_since:
        check_history(r, hist_since)

    worst = max((RANK[i["level"]] for i in r.items if not i["data"].get("past")), default=0)
    if a.json:
        print(json.dumps({"version": VERSION, "time": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
                          "worst": [OK, WARN, ERROR][worst], "items": r.items}, ensure_ascii=False, indent=2))
    else:
        color = not a.no_color and sys.stdout.isatty() and not os.environ.get("NO_COLOR")
        if a.verbose:
            render(r, color, hist)
        else:
            render_brief(r, color, hist)
    return worst


if __name__ == "__main__":
    sys.exit(main())
